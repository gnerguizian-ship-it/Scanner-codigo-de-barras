<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lector de Códigos de Barras</title>
<script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<style>
  :root{
    --bg:#0f1115; --panel:#171a21; --border:#262a33;
    --text:#e8e9ec; --muted:#9aa0ab; --accent:#4f8cff; --accent2:#22c55e; --danger:#ef4444;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    background:var(--bg); color:var(--text); min-height:100vh;
    display:flex; justify-content:center; padding:24px 16px;
  }
  .wrap{width:100%; max-width:520px;}
  h1{font-size:1.4rem; margin:0 0 4px;}
  p.sub{color:var(--muted); margin:0 0 20px; font-size:.9rem;}
  .panel{background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:16px; margin-bottom:16px;}
  #reader{width:100%; border-radius:8px; overflow:hidden;}
  .controls{display:flex; gap:8px; flex-wrap:wrap; margin-top:12px;}
  button{
    background:var(--accent); color:#fff; border:none; padding:10px 16px;
    border-radius:8px; font-size:.9rem; cursor:pointer; font-weight:600;
  }
  button.secondary{background:transparent; border:1px solid var(--border); color:var(--text);}
  button.danger{background:var(--danger);}
  button:disabled{opacity:.5; cursor:not-allowed;}
  input[type=text]{
    flex:1; min-width:160px; background:#0f1115; border:1px solid var(--border);
    color:var(--text); padding:10px 12px; border-radius:8px; font-size:.9rem;
  }
  .row{display:flex; gap:8px; margin-top:12px;}
  .result{display:none;}
  .result.show{display:block;}
  .code-value{
    font-family:ui-monospace,Menlo,Consolas,monospace; font-size:1.3rem;
    color:var(--accent2); word-break:break-all; margin:4px 0 2px;
  }
  .format-tag{
    display:inline-block; background:#1f2937; color:var(--muted);
    font-size:.75rem; padding:2px 8px; border-radius:999px; margin-top:4px;
  }
  .product{display:flex; gap:12px; margin-top:14px; align-items:flex-start;}
  .product img{width:64px; height:64px; object-fit:contain; background:#fff; border-radius:6px;}
  .product h3{margin:0 0 4px; font-size:1rem;}
  .product p{margin:2px 0; font-size:.85rem; color:var(--muted);}
  .status{font-size:.85rem; color:var(--muted); margin-top:10px;}
  .status.error{color:var(--danger);}
  .status.loading{color:var(--accent);}
  footer{text-align:center; color:var(--muted); font-size:.75rem; margin-top:20px;}
  a{color:var(--accent);}
</style>
</head>
<body>
<div class="wrap">
  <h1>📷 Lector de Códigos de Barras</h1>
  <p class="sub">Escanea con la cámara, sube una imagen o escribe el código manualmente.</p>

  <div class="panel">
    <div id="reader"></div>
    <div class="controls">
      <button id="startBtn">Iniciar cámara</button>
      <button id="stopBtn" class="secondary" disabled>Detener</button>
      <label class="secondary" style="padding:10px 16px;border:1px solid var(--border);border-radius:8px;cursor:pointer;">
        Subir imagen
        <input type="file" id="fileInput" accept="image/*" style="display:none;">
      </label>
    </div>
  </div>

  <div class="panel">
    <div class="row">
      <input type="text" id="manualInput" placeholder="O escribe el código aquí (ej. 7501234567890)">
      <button id="manualBtn">Buscar</button>
    </div>
  </div>

  <div class="panel result" id="resultPanel">
    <div>Código detectado:</div>
    <div class="code-value" id="codeValue"></div>
    <span class="format-tag" id="formatTag"></span>
    <div class="status" id="lookupStatus"></div>
    <div class="product" id="productBox" style="display:none;">
      <img id="productImg" alt="">
      <div>
        <h3 id="productName"></h3>
        <p id="productBrand"></p>
        <p id="productQty"></p>
      </div>
    </div>
  </div>

  <footer>
    Escaneo local con <a href="https://github.com/mebjas/html5-qrcode" target="_blank">html5-qrcode</a>.
    Datos de producto vía <a href="https://world.openfoodfacts.org/" target="_blank">Open Food Facts</a> (gratuito, sin API key).
  </footer>
</div>

<script>
const startBtn = document.getElementById('startBtn');
const stopBtn = document.getElementById('stopBtn');
const fileInput = document.getElementById('fileInput');
const manualInput = document.getElementById('manualInput');
const manualBtn = document.getElementById('manualBtn');
const resultPanel = document.getElementById('resultPanel');
const codeValue = document.getElementById('codeValue');
const formatTag = document.getElementById('formatTag');
const lookupStatus = document.getElementById('lookupStatus');
const productBox = document.getElementById('productBox');
const productImg = document.getElementById('productImg');
const productName = document.getElementById('productName');
const productBrand = document.getElementById('productBrand');
const productQty = document.getElementById('productQty');

const formatsToSupport = [
  Html5QrcodeSupportedFormats.EAN_13,
  Html5QrcodeSupportedFormats.EAN_8,
  Html5QrcodeSupportedFormats.UPC_A,
  Html5QrcodeSupportedFormats.UPC_E,
  Html5QrcodeSupportedFormats.CODE_128,
  Html5QrcodeSupportedFormats.CODE_39,
  Html5QrcodeSupportedFormats.CODABAR,
  Html5QrcodeSupportedFormats.ITF,
  Html5QrcodeSupportedFormats.QR_CODE,
];

let html5QrCode;
let scanning = false;

function initScanner() {
  if (!html5QrCode) {
    html5QrCode = new Html5Qrcode("reader", { formatsToSupport, verbose: false });
  }
}

function onScanSuccess(decodedText, decodedResult) {
  const format = decodedResult?.result?.format?.formatName || 'Desconocido';
  showResult(decodedText, format);
  stopScanner();
}

function startScanner() {
  initScanner();
  const config = { fps: 10, qrbox: { width: 260, height: 160 } };
  html5QrCode.start({ facingMode: "environment" }, config, onScanSuccess)
    .then(() => {
      scanning = true;
      startBtn.disabled = true;
      stopBtn.disabled = false;
    })
    .catch(err => {
      alert("No se pudo acceder a la cámara: " + err);
    });
}

function stopScanner() {
  if (html5QrCode && scanning) {
    html5QrCode.stop().then(() => {
      scanning = false;
      startBtn.disabled = false;
      stopBtn.disabled = true;
    }).catch(() => {});
  }
}

startBtn.addEventListener('click', startScanner);
stopBtn.addEventListener('click', stopScanner);

fileInput.addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  initScanner();
  html5QrCode.scanFile(file, true)
    .then(decodedText => showResult(decodedText, 'Imagen subida'))
    .catch(err => {
      lookupStatus.textContent = "No se detectó ningún código en la imagen.";
      lookupStatus.className = "status error";
      resultPanel.classList.add('show');
    });
});

manualBtn.addEventListener('click', () => {
  const val = manualInput.value.trim();
  if (val) showResult(val, 'Ingresado manualmente');
});
manualInput.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') manualBtn.click();
});

function showResult(text, format) {
  resultPanel.classList.add('show');
  codeValue.textContent = text;
  formatTag.textContent = format;
  productBox.style.display = 'none';
  lookupStatus.textContent = '';
  lookupStatus.className = 'status';

  // Solo tiene sentido buscar producto para códigos numéricos tipo EAN/UPC
  if (/^\d{8,14}$/.test(text)) {
    lookupProduct(text);
  } else {
    lookupStatus.textContent = 'Este formato no corresponde a un código de producto (EAN/UPC), así que no se buscará en la base de datos.';
  }
}

async function lookupProduct(code) {
  lookupStatus.textContent = 'Buscando información del producto…';
  lookupStatus.className = 'status loading';
  try {
    const res = await fetch(`https://world.openfoodfacts.org/api/v2/product/${code}.json`);
    const data = await res.json();
    if (data.status === 1 && data.product) {
      const p = data.product;
      productName.textContent = p.product_name || 'Nombre no disponible';
      productBrand.textContent = p.brands ? `Marca: ${p.brands}` : '';
      productQty.textContent = p.quantity ? `Cantidad: ${p.quantity}` : '';
      productImg.src = p.image_front_small_url || p.image_url || '';
      productBox.style.display = productImg.src ? 'flex' : 'block';
      lookupStatus.textContent = 'Producto encontrado en Open Food Facts.';
      lookupStatus.className = 'status';
    } else {
      lookupStatus.textContent = 'Código válido, pero no se encontró en la base de datos de productos.';
      lookupStatus.className = 'status error';
    }
  } catch (err) {
    lookupStatus.textContent = 'No se pudo consultar la base de datos (sin conexión o error de red).';
    lookupStatus.className = 'status error';
  }
}
</script>
</body>
</html>
